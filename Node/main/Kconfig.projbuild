menu "Mesh Configuration"

    config ESP_MESH_MAX_LAYER
        int "Max Mesh Layer"
        range 1 10
        default 3
        help
            Maximum number of mesh layers.

    config ESP_MESH_CHANNEL
        int "Mesh Channel (FIXED)"
        range 1 13
        default 6
        help
            Fixed channel for ESP-MESH.
            All nodes MUST use the same channel.

    config ESP_WIFI_SSID
        string "Router SSID"
        default "CEEC_Tenda"
        help
            Router SSID (used by ROOT only).

    config ESP_WIFI_PASSWORD
        string "Router Password"
        default "1denmuoi1"
        help
            Router password (used by ROOT only).

    config ESP_GTK_REKEYING_ENABLE
        bool "Enable GTK Rekeying"
        default y

    config ESP_GTK_REKEY_INTERVAL
        int "GTK Rekey Interval (s)"
        depends on ESP_GTK_REKEYING_ENABLE
        range 60 65535
        default 600

endmenu
